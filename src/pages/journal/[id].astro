---
import { render } from "astro:content";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import { getPublished, getReadingTime } from "../../helpers/helpers";

export const getStaticPaths = async () => {
  const posts = await getPublished("journal");
  const sortedPosts = posts.toSorted((a, b) => {
    const aDate = a.data.createdAt.getTime();
    const bDate = b.data.createdAt.getTime();
    return bDate - aDate;
  });
  return sortedPosts.map((post, index) => {
    const nextPost = sortedPosts[index + 1] ?? sortedPosts[0];
    return {
      params: {
        id: post.id,
      },
      props: { post, nextPost },
    };
  });
};

const { post, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body ?? "");
---

<BlogPostLayout
  id={post.id}
  headings={headings}
  readingTime={readingTime}
  nextPost={nextPost}
  {...post.data}
>
  <Content />
</BlogPostLayout>
