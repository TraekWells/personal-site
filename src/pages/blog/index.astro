---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getCollection("blog");
---

<BaseLayout>
  <h1>Notes on the front-end</h1>
  <p>
    Long-form and short thoughts on CSS, layout systems, accessibility, and the
    small details that make interfaces feel considered.
  </p>
  <ul>
    {
      posts.map((post) => {
        const { title } = post.data;
        return (
          <li>
            <a href={`/blog/${post.id}`}>{title}</a>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
