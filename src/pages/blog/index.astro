---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { PencilLine } from "@lucide/astro/icons/index";
import { getPublished } from "../../helpers/helpers";
import PostGrid from "../../components/PostGrid.astro";

const posts = await getPublished("blog");
const sortedPosts = posts.toSorted((a, b) => {
  const aDate = a.data.createdAt.getTime();
  const bDate = b.data.createdAt.getTime();
  return bDate - aDate;
});
---

<BaseLayout
  metaTitle="Writing on CSS, Layout & Accessibility • Traek Wells"
  metaDescription="Long-form and short thoughts on CSS, layout systems, accessibility and the small details that make interfaces feel considered."
>
  <section>
    <SectionHeader
      as="h1"
      styleAs="h2"
      eyebrow="Writing"
      header="Front-end notes"
    >
      <PencilLine size={16} slot="icon" />
      <p class="lead" slot="intro">
        Long-form and short thoughts on CSS, layout systems, accessibility, and
        the small details that make interfaces feel considered.
      </p>
      <small slot="meta">{posts.length} articles</small>
    </SectionHeader>
  </section>
  <section>
    <PostGrid posts={sortedPosts} />
  </section>
</BaseLayout>
