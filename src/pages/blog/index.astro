---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { PencilLine } from "@lucide/astro/icons/index";
import { getPublished } from "../../helpers/helpers";

const posts = await getPublished("blog");
---

<BaseLayout>
  <section>
    <SectionHeader as="h1" eyebrow="Writing" header="Front-end notes">
      <PencilLine size={16} slot="icon" />
      <p class="lead" slot="intro">
        Long-form and short thoughts on CSS, layout systems, accessibility, and
        the small details that make interfaces feel considered.
      </p>
    </SectionHeader>
  </section>
  <ul>
    {
      posts.map((post) => {
        const { title } = post.data;
        return (
          <li>
            <a href={`/blog/${post.id}`}>{title}</a>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
