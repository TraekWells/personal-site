---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ArrowRight, BookSearch, PencilLine } from "@lucide/astro";
import SectionHeader from "../components/SectionHeader.astro";
import ArticleList from "../components/ArticleList.astro";
import ArticleListItem from "../components/ArticleListItem.astro";
import { getPublished } from "../helpers/helpers";
import IntroHero from "../components/IntroHero.astro";
import SectionCard from "../components/SectionCard.astro";

const exploreLinks = [
  {
    title: "Bookshelf",
    url: "/bookshelf",
    eyebrow: "Sometimes I read",
  },
  {
    title: "Impossible List",
    url: "/journal/impossible-list",
    eyebrow: "Get after it",
  },
  {
    title: "Now",
    url: "/now",
    eyebrow: "What am I doing?",
  },
  {
    title: "Today I learned",
    url: "/today-i-learned",
    eyebrow: "Stay sharp",
  },
  {
    title: "Journal",
    url: "/journal",
    eyebrow: "Stay sharp",
  },
];

const posts = await getPublished("blog");
const sortedPosts = posts.toSorted((a, b) => {
  const aDate = a.data.createdAt.getTime();
  const bDate = b.data.createdAt.getTime();
  return bDate - aDate;
});
---

<BaseLayout
  metaTitle="Traek Wells"
  metaDescription="Front-end development and UI design tutorials, free resources and deep dives from Traek Wells, creator of The UI Layer on YouTube."
>
  <IntroHero />
  <section>
    <SectionHeader
      as="h2"
      styleAs="h3"
      eyebrow="Writing"
      header="Front-end Notes"
    >
      <PencilLine size={16} slot="icon" />
      <a href="/blog" slot="action">All Articles <ArrowRight size={16} /></a>
    </SectionHeader>
    <ArticleList>
      {
        sortedPosts.map((post) => {
          return <ArticleListItem post={post} />;
        })
      }
    </ArticleList>
  </section>

  <section>
    <SectionHeader
      as="h2"
      styleAs="h3"
      eyebrow="Explore the Site"
      header="Peek around"
    >
      <BookSearch size={16} slot="icon" />
    </SectionHeader>
    <div class="section-card-grid">
      {
        exploreLinks.map((link, index) => {
          return (
            <SectionCard
              title={link.title}
              url={link.url}
              eyebrow={link.eyebrow}
              index={`0${index + 1}`}
            />
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  .section-card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xs);

    @media (width >= 650px) {
      grid-template-columns: repeat(6, 1fr);

      > :global(*) {
        grid-column: span 2;
      }

      > :global(:nth-child(-n + 2)) {
        grid-column: span 3;
      }
    }
  }
</style>
