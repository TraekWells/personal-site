---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ArrowRight, BookSearch, PencilLine } from "@lucide/astro";
import SectionHeader from "../components/SectionHeader.astro";
import ArticleList from "../components/ArticleList.astro";
import ArticleListItem from "../components/ArticleListItem.astro";

const posts = await getCollection("blog");
---

<BaseLayout>
  <small
    >I'm re-building this site ad-hoc and pushing whatever changes I have some.
    You've been warned.</small
  >
  <h1>Designed with intent. Built with care.</h1>
  <p>
    I build fast, accessible interfaces with clean CSS, and I care about the
    small details most people miss. Lately I've been focused on design systems
    and UI components for product teams.
  </p>

  <section>
    <SectionHeader eyebrow="Writing" header="Front-end Notes">
      <PencilLine size={16} slot="icon" />
      <a href="/blog" slot="action">All Articles <ArrowRight size={16} /></a>
    </SectionHeader>
    <ArticleList>
      {
        posts.map((post) => {
          return <ArticleListItem post={post} />;
        })
      }
    </ArticleList>
  </section>

  <section>
    <SectionHeader eyebrow="Explore the Site" header="Peek around">
      <BookSearch size={16} slot="icon" />
    </SectionHeader>
  </section>
</BaseLayout>
