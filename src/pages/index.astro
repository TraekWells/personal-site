---
import { getCollection } from "astro:content";
import Eyebrow from "../components/Eyebrow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = await getCollection("blog");
const projects = await getCollection("projects");

import { FolderGit2, PencilLine } from "@lucide/astro";
import ProjectCard from "../components/ProjectCard.astro";
---

<BaseLayout>
  <h1>
    I'm re-building this site ad-hoc and pushing whatever changes I have some.
    You've been warned.
  </h1>
  <p>
    Stuff is and will be broken until it's finished. But thanks for visiting.
    Come back soon.
  </p>

  <section>
    <hgroup>
      <Eyebrow><FolderGit2 size={16} />Selected Work</Eyebrow>
      <h2 class="heading-2">Stuff I've Made</h2>
    </hgroup>
    <div class="project-wrapper">
      {
        projects.map((project) => {
          return (
            <ProjectCard
              title={project.data.title}
              summary={project.data.summary}
              tag={project.data.technology[0]}
            />
          );
        })
      }
    </div>
  </section>

  <section>
    <hgroup>
      <Eyebrow><PencilLine size={16} />Writing</Eyebrow>
      <h2 class="heading-2">Front-end Notes</h2>
    </hgroup>
    {
      posts.map((post) => {
        return <li>{post.data.title}</li>;
      })
    }
  </section>

  <section>
    <hgroup>
      <Eyebrow><PencilLine size={16} />Explore the Site</Eyebrow>
      <h2 class="heading-2">Peek Around</h2>
    </hgroup>
  </section>
</BaseLayout>
