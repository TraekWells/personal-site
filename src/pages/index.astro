---
import { getCollection } from "astro:content";
import Eyebrow from "../components/Eyebrow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = await getCollection("blog");

import { ArrowRight, PencilLine } from "@lucide/astro";
import SectionHeader from "../components/SectionHeader.astro";
import ArticleList from "../components/ArticleList.astro";
import ArticleListItem from "../components/ArticleListItem.astro";
---

<BaseLayout>
  <h1>
    I'm re-building this site ad-hoc and pushing whatever changes I have some.
    You've been warned.
  </h1>
  <p>
    Stuff is and will be broken until it's finished. But thanks for visiting.
    Come back soon.
  </p>

  <section>
    <SectionHeader eyebrow="Writing" header="Front-end Notes">
      <PencilLine size={16} slot="icon" />
      <a href="/blog" slot="action">All Articles <ArrowRight size={16} /></a>
    </SectionHeader>
    <ArticleList>
      {
        posts.map((post) => {
          return <ArticleListItem post={post} />;
        })
      }
    </ArticleList>
  </section>

  <section>
    <hgroup>
      <Eyebrow><PencilLine size={16} />Explore the Site</Eyebrow>
      <h2 class="heading-2">Peek Around</h2>
    </hgroup>
  </section>
</BaseLayout>
