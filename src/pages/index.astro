---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ArrowRight, BookSearch, PencilLine } from "@lucide/astro";
import SectionHeader from "../components/SectionHeader.astro";
import ArticleList from "../components/ArticleList.astro";
import ArticleListItem from "../components/ArticleListItem.astro";
import { getPublished } from "../helpers/helpers";
import IntroHero from "../components/IntroHero.astro";

const posts = await getPublished("blog");
---

<BaseLayout
  title="Traek Wells"
  description="Learn front-end development and UI design with Traek Wells: tutorials, free resources, and deep dives from the creator of The UI Layer on YouTube."
>
  <IntroHero />
  <section>
    <SectionHeader
      as="h2"
      styleAs="h3"
      eyebrow="Writing"
      header="Front-end Notes"
    >
      <PencilLine size={16} slot="icon" />
      <a href="/blog" slot="action">All Articles <ArrowRight size={16} /></a>
    </SectionHeader>
    <ArticleList>
      {
        posts.map((post) => {
          return <ArticleListItem post={post} />;
        })
      }
    </ArticleList>
  </section>

  <section>
    <SectionHeader
      as="h2"
      styleAs="h3"
      eyebrow="Explore the Site"
      header="Peek around"
    >
      <BookSearch size={16} slot="icon" />
    </SectionHeader>
    <p>Coming soon</p>
  </section>
</BaseLayout>
