---
import { getCollection } from "astro:content";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = await getCollection("blog");

import { PencilLine } from "@lucide/astro";
---

<BaseLayout>
  <h1>
    I'm re-building this site ad-hoc and pushing whatever changes I have some.
    You've been warned.
  </h1>
  <p>
    Stuff is and will be broken until it's finished. But thanks for visiting.
    Come back soon.
  </p>

  <hgroup>
    <Eyebrow><PencilLine size={16} />Selected Work</Eyebrow>
    <h2 class="heading-2">Front-end Notes</h2>
  </hgroup>

  {
    posts.map((post) => {
      return <li>{post.data.title}</li>;
    })
  }
</BaseLayout>
