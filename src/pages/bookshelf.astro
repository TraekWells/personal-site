---
import { Book } from "@lucide/astro";
import PageHero from "../components/PageHero.astro";
import Pill from "../components/Pill.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import BookGridSection from "../components/BookGridSection.astro";

const books = await getCollection("books");

const currentlyReading = books.filter((book) => {
  return book.data.currentlyReading;
});
const booksDnfed = books.filter((book) => book.data.didNotFinish);
const finishedBooks = books.filter((book) => book.data.dateRead);
const byYear = finishedBooks.reduce<Record<number, typeof finishedBooks>>(
  (acc, book) => {
    const year = book.data.dateRead!.getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }

    acc[year].push(book);
    return acc;
  },
  {},
);

const organizedBooks = Object.entries(byYear)
  .map(([year, yearBooks]) => {
    return {
      year: Number(year),
      books: yearBooks.sort(
        (a, b) => b.data.dateRead!.getTime() - a.data.dateRead!.getTime(),
      ),
    };
  })
  .sort((a, b) => b.year - a.year);
---

<BaseLayout
  metaTitle="Bookshelf"
  metaDescription="A digital shelf of what I've been reading"
>
  <PageHero
    eyebrow="bookshelf"
    title="A digital shelf of what I've been reading"
    description="test"
  >
    <Book slot="icon" size={16} />
    <div class="pills" slot="meta">
      <Pill>{books.length} books read</Pill>
      <Pill>DNFed {booksDnfed.length} books</Pill>
    </div>
  </PageHero>
  <BookGridSection title="Currently Reading" books={currentlyReading} />
  {
    organizedBooks.map(({ year, books }) => (
      <BookGridSection title={`${year}`} books={books} />
    ))
  }
</BaseLayout>

<style>
  .pills {
    display: flex;
    gap: var(--space-3xs);
  }
</style>
