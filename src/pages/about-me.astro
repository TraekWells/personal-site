---
import {
  BookType,
  Code,
  CodeXml,
  Heart,
  MessageCircle,
  Video,
} from "@lucide/astro";
import Eyebrow from "../components/Eyebrow.astro";
import AboutHero from "../components/AboutHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import PrincipleCard from "../components/PrincipleCard.astro";
import SocialLinkCard from "../components/SocialLinkCard.astro";
---

<BaseLayout
  metaTitle="About"
  metaDescription="Front-end developer and UI designer. Learn about my background, what I work on and where to find me."
>
  <section>
    <AboutHero />
  </section>
  <section>
    <!-- Create a toggle that shows a short version and a longer version of my bio -->
    <div class="grid-of-three">
      <Eyebrow><CodeXml size={20} />About me</Eyebrow>
      <div class="bio">
        <p class="lead">
          Howdy. I'm Traek Wells, a front-end developer who loves learning the
          intricacies of how things work.
        </p>
        <p>
          Outside of coding, I love testing the limits of my fitness in the form
          of endurance sports (namely running). I'm learning how to play the
          guitar and trying to get better at chess ♟️. Most importantly, I'm
          doing my best to raise my two kids and be the best husband and role
          model possible.
        </p>
      </div>
    </div>
  </section>
  <section>
    <SectionHeader
      as="h2"
      styleAs="h4"
      eyebrow="Personal Values"
      header="How I work"
    >
      <Heart size={16} slot="icon" />
      <p slot="action" class="meta">A few things I believe</p>
    </SectionHeader>
    <div class="grid-of-three">
      <PrincipleCard
        index="01"
        title="Clarity over cleverness"
        description="The best interface is usually the one that makes the next step feel obvious."
      />
      <PrincipleCard
        index="02"
        title="Take calculated risks"
        description="Because life is way too short and unpredictable to play it safe."
      />
      <PrincipleCard
        index="03"
        title="User first"
        description="Accessible from step one, usable by all."
      />
    </div>
  </section>
  <section>
    <SectionHeader
      as="h2"
      styleAs="h4"
      eyebrow="On the innerwebs"
      header="Let's connect"
    >
      <MessageCircle size={16} slot="icon" />
      <p slot="action" class="meta">A few places I hang out</p>
    </SectionHeader>
    <div class="grid-of-three">
      <SocialLinkCard
        platform="LinkedIn"
        handle="traekwells"
        url="https://www.linkedin.com/in/traekwells/"
      >
        <Code size={20} slot="icon" />
      </SocialLinkCard>
      <SocialLinkCard
        platform="YouTube"
        handle="@theuilayer"
        url="https://www.youtube.com/@theuilayer"
      >
        <Video size={20} slot="icon" />
      </SocialLinkCard>
    </div>
  </section>
</BaseLayout>

<style>
  .meta {
    color: hsl(var(--color-text-light));
    font-size: var(--font-size-xs);
    font-family: var(--font-family-mono);
  }

  .bio {
    grid-column: span 2;

    .lead {
      color: hsl(var(--color-primary-darkest));
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-bold);
      line-height: var(--heading-4-line-height);
    }

    p {
      font-size: var(--font-size-md);
      color: hsla(var(--color-base-dark));
    }
    * + * {
      margin-block-start: var(--space-sm);
    }
  }
</style>
