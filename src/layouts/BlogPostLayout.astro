---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { ArrowLeft } from "@lucide/astro";
import TableOfContents from "../components/TableOfContents.astro";
import PostHeader from "../components/PostHeader.astro";
import { formatDate } from "../helpers/helpers";
import ReadNext from "../components/ReadNext.astro";

type Props = CollectionEntry<"blog">["data"] & {
  id: string;
  headings: MarkdownHeading[];
  readingTime: string;
  nextPost: CollectionEntry<"blog">;
};

const { id, title, summary, tags, createdAt, headings, readingTime, nextPost } =
  Astro.props;
const date = formatDate(createdAt);
const tag = tags && tags[0];
---

<BaseLayout>
  <div class="post">
    <section>
      <a href="/blog" class="post-back">
        <ArrowLeft size={16} /> All writing
      </a>
    </section>
    <section>
      <div class="post-wrapper">
        <div class="post-sidebar">
          <TableOfContents title="On this page" headers={headings} id={id} />
        </div>
        <div class="post-main">
          <PostHeader
            header={title}
            intro={summary}
            readingTime={readingTime}
            date={date}
            tag={tag}
          />
          <div class="post-body flow">
            <slot />
          </div>
        </div>
      </div>
    </section>
  </div>
  <ReadNext post={nextPost} />
</BaseLayout>

<style>
  .post {
    section {
      margin-block-start: var(--space-md);
    }
  }
  .post-back {
    font-size: var(--font-size-sm);
    color: hsl(var(--color-text));
    svg {
      transition: transform ease var(--transition-slow);
    }

    &:hover {
      svg {
        transform: translateX(-5px);
      }
    }
  }
  .post-wrapper {
    display: flex;
    flex-direction: row-reverse;
    gap: var(--space-lg);
    position: relative;
  }

  .post-sidebar {
    display: none;

    @media (width >= 700px) {
      position: sticky;
      display: initial;
      flex: 1;
      flex-shrink: 0;
      align-self: flex-start;
      top: 7rem;
    }
  }

  .post-main {
    flex: 3;
  }

  .post-body {
    margin-block-start: var(--space-md);
  }
</style>
