---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button"> & {
  variant?: "primary" | "secondary" | "ghost";
};

const { variant, class: className, type = "button", ...rest } = Astro.props;
---

<button type={type} data-variant={variant} class:list={[className]} {...rest}>
  <slot />
</button>

<style>
  button {
    color: hsl(var(--color-base-white));
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    border-radius: var(--border-radius-md);
    border: 1px solid transparent;
    padding: var(--space-2xs) var(--space-xs);
    background-color: hsl(var(--color-primary-dark));
    transition: var(--transition-slow);
    cursor: pointer;
    flex-shrink: 0;

    svg {
      transition: var(--transition-slow);
    }

    &:hover {
      background-color: hsl(var(--color-primary-darker));

      svg {
        transform: translateX(4px);
      }
    }
  }
</style>
