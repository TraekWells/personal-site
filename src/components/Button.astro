---
import type { HTMLAttributes } from "astro/types";

type BaseProps = {
  variant?: "primary" | "secondary" | "ghost";
};

type ButtonProps = BaseProps &
  HTMLAttributes<"button"> & {
    as?: "button";
    href?: never;
  };

type AnchorProps = BaseProps &
  Omit<HTMLAttributes<"a">, "href"> & {
    as: "a";
    href: string;
  };

type Props = ButtonProps | AnchorProps;

const { as, variant, class: className, ...props } = Astro.props;
---

{
  as === "a" ? (
    <a data-variant={variant} class:list={[className]} {...props}>
      <slot />
    </a>
  ) : (
    <button
      type="button"
      data-variant={variant}
      class:list={[className]}
      {...props}
    >
      <slot />
    </button>
  )
}

<style>
  button,
  a {
    color: hsl(var(--color-base-white));
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    border-radius: var(--border-radius-md);
    border: 1px solid transparent;
    padding: var(--space-2xs) var(--space-xs);
    background-color: hsl(var(--color-primary-dark));
    transition: var(--transition-slow);
    cursor: pointer;
    flex-shrink: 0;
    text-decoration: none;
    font-size: var(--font-size-base);

    svg {
      transition: var(--transition-slow);
    }

    &:hover {
      background-color: hsl(var(--color-primary-darker));

      svg {
        transform: translateX(4px);
      }
    }
  }
</style>
