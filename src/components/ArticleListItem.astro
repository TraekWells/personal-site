---
import { ArrowUpRight } from "@lucide/astro";
import { formatDate, getReadingTime } from "../helpers/helpers";

type PostTypes = {
  id: string;
  body?: string;
  data: {
    title: string;
    createdAt: Date;
  };
};

type Props = {
  post: PostTypes;
};

const { post } = Astro.props;

const { title, createdAt } = post.data;
const date = formatDate(createdAt);
const url = `/blog/${post.id}`;
const readingTime = getReadingTime(post.body ?? "");
---

<li class="article-list-item">
  <a href={url} class="article-list-item__link">
    {title}
    <p class="article-list-item__meta">{date} • {readingTime}</p>
    <ArrowUpRight size={16} class="article-list-item__icon" />
  </a>
</li>

<style>
  .article-list-item {
    position: relative;
    &:not(:last-of-type) {
      border-bottom: var(--thin-border);
    }
  }

  .article-list-item__link {
    background-color: hsl(var(--color-base-lightest));
    display: block;
    color: hsl(var(--color-base-text));
    text-decoration: none;
    padding: var(--space-xs);
    font-weight: var(--font-weight-bold);
    &:hover {
      background-color: hsl(var(--color-base-lighter));
      .article-list-item__icon {
        transform: translate(3.5px, -3.5px);
      }
    }
  }

  .article-list-item__meta {
    color: hsl(var(--color-text-light));

    font-weight: var(--font-weight-normal);
    font-size: var(--font-size-sm);
  }

  .article-list-item__icon {
    position: absolute;
    right: var(--space-xs);
    top: var(--space-xs);
    transition: transform ease var(--transition-slow);
  }
</style>
