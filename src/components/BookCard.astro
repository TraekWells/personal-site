---
import type { CollectionEntry } from "astro:content";
import BookRating from "./BookRating.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type BookTypes = CollectionEntry<"books">["data"];

type Props = {
  book: Pick<
    BookTypes,
    "title" | "author" | "rating" | "bookCover" | "didNotFinish"
  >;
};

const { book } = Astro.props;

const covers = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/bookshelf/*.{jpg,jpeg,png,webp}",
  { eager: true },
);

// Frontmatter paths look like "../../assets/bookshelf/x.jpg"; resolve to a glob key.
const cover = covers[book.bookCover.replace(/^(\.\.\/)+/, "/src/")]?.default;
---

<article class="book-card">
  {book.didNotFinish && <span class="book-card__dnf">DNF</span>}
  <div class="book-card__image-wrapper">
    {
      cover && (
        <Image
          class="book-card__image"
          src={cover}
          alt={`Book cover of ${book.title}`}
          width={700}
          height={500}
        />
      )
    }
  </div>
  <div class="book-card__content">
    {book.rating !== 0 && <BookRating rating={book.rating} />}
    <div class="book-card__text">
      <h3 class="book-card__title heading-5">{book.title}</h3>
      <p class="book-card__author">{book.author}</p>
    </div>
  </div>
</article>

<style>
  .book-card {
    position: relative;
    display: flex;
    gap: var(--space-xs);
    background-color: hsl(var(--color-base-lightest));
    border: var(--thin-border);
    border-radius: var(--border-radius-sm);
    padding: var(--space-sm);
    /* overflow: hidden; */

    &:hover {
      .book-card__image {
        transform: scale(1.1);
      }
    }
  }

  .book-card__dnf {
    position: absolute;
    right: 2px;
    top: 2px;
    background-color: hsl(var(--color-primary-dark));
    color: hsl(var(--color-base-white));
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    padding-inline: var(--space-2xs);
    padding-block: var(--space-3xs);
    border-radius: var(--border-radius-sm);
    transform: rotate(90deg);
  }

  .book-card__image-wrapper {
    height: 13rem;
    width: 9rem;
    overflow: hidden;
    border-radius: var(--border-radius-sm);
  }

  .book-card__image {
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .book-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .book-card__author {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
    color: hsl(var(--color-primary-darker));
  }
</style>
