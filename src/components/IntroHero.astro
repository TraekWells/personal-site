---
import { ArrowRight, MapPin } from "@lucide/astro";
import { Image } from "astro:assets";
import heroImage from "../images/hero-image.webp";
import Button from "./Button.astro";
---

<div class="intro-hero">
  <div class="intro-hero__portrait">
    <Image src={heroImage} alt="My mugshot" />
  </div>
  <div class="intro-hero__content">
    <small>Hello, I'm Traek</small>
    <h1 class="heading-2">Designed with intent. Built with care.</h1>
    <p>
      I build fast, accessible interfaces with clean CSS, and I care about the
      small details most people miss. Lately I've been focused on design systems
      and UI components for product teams.
    </p>
    <div class="intro-hero__content-actions">
      <Button>See my work <ArrowRight size={16} /></Button>
      <span class="location">
        <MapPin size={16} /> Saint Paul, MN
      </span>
    </div>
    <div class="intro-hero__extra">
      <p>
        Cool interfaces, solid systems, and those little things that make
        products feel easy to use.
      </p>
    </div>
  </div>
</div>

<style>
  .intro-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
    margin-block-start: var(--space-xl);

    @media (width >= 700px) {
      grid-template-columns: 1fr 2fr;
    }
  }

  .intro-hero__content,
  .intro-hero__portrait {
    border-radius: var(--border-radius-md);
    border: var(--thin-border);
    overflow: hidden;
  }

  .intro-hero__portrait {
    position: relative;
    isolation: isolate;
    display: none;

    @media (width >= 700px) {
      display: unset;
    }

    img {
      width: 100%;
      height: auto;
      object-fit: cover;
      height: 100%;
      filter: grayscale(1) brightness(1.1);
    }

    &::after {
      content: "";
      inset: 0;
      position: absolute;
      height: 100%;
      width: 100%;
      background-color: hsl(var(--color-primary-lighter));
      mix-blend-mode: multiply;
    }
  }

  .intro-hero__content {
    position: relative;
    background-color: hsl(var(--color-primary-lightest));
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);

    @media (width >= 700px) {
      background-color: unset;
      padding: var(--space-lg);
    }

    small {
      font-family: var(--font-family-mono);
    }

    &::after {
      content: "";
      z-index: -1;
      top: -4rem;
      right: -4rem;
      position: absolute;
      height: 13rem;
      width: 13rem;
      border: 1.25rem solid hsl(var(--color-primary-lighter));
      border-radius: 50%;
    }
  }

  .intro-hero__content-actions {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    flex-direction: column;

    @media (width >= 700px) {
      flex-direction: unset;
      align-items: center;
    }
  }

  .location {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    color: hsl(var(--color-text-light));
  }

  .intro-hero__extra {
    border-top: var(--thin-border);
    padding-block-start: var(--space-sm);

    p {
      font-family: var(--font-family-mono);
      font-size: var(--font-size-xs);
      color: hsl(var(--color-text-light));
    }
  }
</style>
