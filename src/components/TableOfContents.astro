---
import type { MarkdownHeading } from "astro";

type Props = {
  title: string;
  id: string;
  headers: MarkdownHeading[];
};

const { title, id, headers } = Astro.props;
const tocLinks = headers
  .filter((header) => header.depth === 2)
  .map((header) => {
    return {
      text: header.text,
      url: `${id}#${header.slug}`,
    };
  });
---

<aside class="table-of-contents">
  <h3>{title}</h3>
  <!-- <p>{title}</p> -->
  <ul class="table-of-contents__list">
    {
      tocLinks.map((link) => {
        return (
          <li>
            <a class="table-of-contents__link" href={link.url}>
              {link.text}
            </a>
          </li>
        );
      })
    }
  </ul>
</aside>

<style>
  .table-of-contents {
    h3 {
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-normal);
      text-transform: uppercase;
      color: hsl(var(--color-text-light));
    }
  }

  .table-of-contents__list {
    list-style: none;
    padding: 0;
  }
</style>
