---
import type { CollectionEntry } from "astro:content";
import PostCard from "./PostCard.astro";
import { formatDate, getReadingTime } from "../helpers/helpers";

type Props = {
  posts: CollectionEntry<"blog" | "journal">[];
};

const { posts } = Astro.props;
// I'm making the assumption here that the results will all share the same collection
const postType = posts[0].collection;
---

<ul class="post-grid">
  {
    posts.map((post) => {
      const { title, summary, tags } = post.data;
      const hasTags = tags && tags.length > 0;
      const readTime = getReadingTime(post.body ?? "");
      const date = formatDate(post.data.createdAt);
      return (
        // There's probably a better way to get tags from posts
        <li>
          <PostCard
            url={`/${postType}/${post.id}`}
            title={title}
            tag={hasTags ? tags[0] : ""}
            summary={summary}
            date={date}
            readTime={readTime}
          />
        </li>
      );
    })
  }
</ul>

<style>
  .post-grid {
    display: grid;
    list-style: none;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
    padding: 0;
    align-items: stretch;

    @media (width >= 650px) {
      grid-template-columns: 1fr 1fr;
    }

    li {
      display: grid;
    }
  }
</style>
