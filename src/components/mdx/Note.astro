---
import { Info, MessageCircleWarning } from "@lucide/astro";

type Props = {
  type: "info" | "caution" | "success";
};
---

<div class="note">
  <Info size={16} /><MessageCircleWarning size={16} /><slot />
</div>

<style>
  .note {
    border: var(--thin-border);
    padding: var(--space-sm);
    border-radius: var(--border-radius-md);
  }
</style>
