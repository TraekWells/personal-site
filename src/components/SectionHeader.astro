---
import type { Polymorphic } from "astro/types";
import Eyebrow from "./Eyebrow.astro";

type HeadingTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";

type Props<Tag extends HeadingTag> = Polymorphic<{ as: Tag }> & {
  eyebrow: string;
  header: string;
  intro?: string;
  styleAs?: HeadingTag;
};

const { as: Tag, eyebrow, header, styleAs } = Astro.props;
const headingStyle = (styleAs ?? Tag)[1];
---

<header class="section-header">
  <hgroup>
    <Eyebrow><slot name="icon" />{eyebrow}</Eyebrow>
    <div class="section-header__header">
      <Tag class={`heading-${headingStyle}`}>{header}</Tag>
      <slot name="action" />
    </div>
    <slot name="intro" />
  </hgroup>
</header>

<style>
  .section-header {
    a {
      display: flex;
      align-items: center;
      gap: var(--space-3xs);
    }
    .section-header__header {
      display: flex;
      justify-content: space-between;
    }
  }
</style>
