---
import image from "../images/navbar-avatar.webp";
import { MenuIcon, Sun, MoveRightIcon } from "@lucide/astro";
import VisuallyHidden from "./VisuallyHidden.astro";

const border = "1px solid hsl(var(--color-base-light))";

const navItems = [
  {
    label: "Work",
    url: "/work",
  },
  {
    label: "Writing",
    url: "/blog",
  },
  {
    label: "Explore",
    url: "/explore",
  },
  {
    label: "About",
    url: "/about-me",
  },
];
---

<nav class="navbar">
  <div class="navbar__inner container">
    <a class="navbar__logo" href="/">
      <img
        class="navbar__avatar"
        src={image.src}
        alt="Headshot of Traek Wells"
      />
      <div class="navbar__title">
        <p>Traek Wells</p>
        <span>Front-end developer</span>
      </div>
    </a>
    <ul class="navbar__list" data-state="closed">
      {
        navItems.map((item) => {
          return (
            <li>
              <a class="navbar__link" href={item.url}>
                {item.label}
                <MoveRightIcon class="navbar__link-icon" size={16} />
              </a>
            </li>
          );
        })
      }
    </ul>
    <div class="navbar__actions">
      <!-- Add SR only text here -->
      <button
        ><Sun size={16} /><VisuallyHidden>Toggle theme</VisuallyHidden></button
      >
      <button data-mobile-toggle
        ><MenuIcon size={16} /> <span data-mobile-label>Menu</span></button
      >
    </div>
  </div>
</nav>

<style define:vars={{ border }}>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: var(--border);
    color: hsl(var(--color-text));

    a {
      text-decoration: none;
    }
  }

  .navbar__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: var(--space-sm);
  }

  .navbar__logo {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    color: inherit;
    font-family: var(--font-family-mono);
    letter-spacing: var(--letter-spacing-tight);

    p {
      margin-block-end: -5px;
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-bold);
    }

    span {
      font-size: var(--font-size-xs);
      opacity: 0.9;
    }
  }

  .navbar__avatar {
    display: none;

    @media (width >= 650px) {
      display: block;
      aspect-ratio: 1;
      height: 2.5rem;
      border-radius: 50%;
    }
  }

  .navbar__list {
    display: none;
    list-style: none;
    gap: var(--space-2xs);
    font-family: var(--font-family-mono);
    padding: 0;

    &[data-state="open"] {
      display: block;
      position: absolute;
      width: 100%;
      top: 100%;
      left: 0;
      right: 0;
      padding-block: var(--space-md);
      padding-inline: 0;
      background-color: hsl(var(--color-secondary-lightest));
      margin-block-start: -1px;
      border-bottom: var(--border);

      &::before {
        content: "";
        position: absolute;
        width: calc(100% - 2rem);
        height: calc(100% - 2rem);
        top: 1rem;
        left: 1rem;
        border: var(--border);
        border-radius: var(--border-radius-md);
        background-color: hsla(var(--color-base-light), 0.2);
      }

      .navbar__link {
        margin-inline: 2rem;
        margin-block: 0.5rem;
      }
    }

    @media (width >= 650px) {
      display: flex;
    }
  }

  .navbar__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--space-xs);
    padding-block: var(--space-2xs);
    border-radius: var(--border-radius-sm);
    font-size: var(--font-size-sm);
    transition: var(--transition-fast);
    color: inherit;
    opacity: 0.8;

    &:hover {
      background-color: hsl(var(--color-base-light));
      opacity: 1;
    }
  }

  .navbar__link-icon {
    @media (width >= 650px) {
      display: none;
    }
  }

  .navbar__actions {
    display: flex;
    gap: var(--space-3xs);

    button {
      border-radius: var(--border-radius-sm);
      border: var(--border);
      background-color: hsla(var(--color-base-light), 0.2);
      display: inline-flex;
      padding: var(--space-2xs);
      align-items: center;
      gap: var(--space-3xs);
      font-family: var(--font-family-mono);

      &:hover {
        cursor: pointer;
      }
    }

    [data-mobile-toggle] {
      font-size: var(--font-size-xs);
      @media (width >= 650px) {
        display: none;
      }
    }
  }
</style>

<script>
  const initMobileMenu = () => {
    const mobileButton = document.querySelector("[data-mobile-toggle]");
    const mobileLabel = document.querySelector("[data-mobile-label]");
    const navList = document.querySelector("[data-state]");

    if (!mobileButton || !mobileLabel || !navList) return;

    mobileButton.addEventListener("click", () => {
      if (navList.getAttribute("data-state") === "closed") {
        navList.setAttribute("data-state", "open");
        mobileLabel.textContent = "Close";
      } else {
        navList.setAttribute("data-state", "closed");
        mobileLabel.textContent = "Menu";
      }
    });

    const desktop = window.matchMedia("(width >= 650px)");
    desktop.addEventListener("change", (event) => {
      if (event.matches) {
        navList.setAttribute("data-state", "closed");
        mobileLabel.textContent = "Menu";
      }
    });
  };

  initMobileMenu();
</script>
